# Cloudflare Worker Environment Variables

# Required: Your Cloudflare API Token
# Get one from: https://dash.cloudflare.com/profile/api-tokens
# Need "Worker Deploy" and "Account:Cloudflare Workers:Edit" permissions
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Required: Your Cloudflare Account ID
# Find it at the bottom of: https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Optional: jina.ai API Key
# Get one from: https://jina.ai/
JINA_API_KEY=your_jina_api_key_here

# Optional: Custom API endpoint
JINA_API_URL=https://api.jina.ai/v1

# Optional: R2 bucket name (defaults to "hike-gpx-files" from wrangler.toml)
R2_BUCKET_NAME=hike-gpx-files